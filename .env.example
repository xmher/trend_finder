# ============================================
# Trend Finder - API Keys Configuration
# ============================================
# Copy this file to .env and fill in your keys.
# You only need keys for platforms you want to use.
# The app will skip any platform without configured keys.

# --- Reddit ---
# Create an app at https://www.reddit.com/prefs/apps/
# Choose "script" type. Free tier: 100 requests/min.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=TrendFinder/1.0

# --- Twitter / X ---
# Apply at https://developer.x.com/en/portal/dashboard
# NOTE: Free tier is write-only. Basic tier ($100/mo) required for search.
TWITTER_BEARER_TOKEN=

# --- TikTok ---
# Apply at https://developers.tiktok.com/
# Request "Research API" access for trend data.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- Pinterest ---
# Create an app at https://developers.pinterest.com/
# Requires a business account.
PINTEREST_ACCESS_TOKEN=

# --- Threads (Meta) ---
# Create an app at https://developers.facebook.com/
# Add the Threads API product. Requires Instagram business/creator account.
THREADS_ACCESS_TOKEN=

# --- Google Trends ---
# No API key needed! Works out of the box via pytrends.
# Google Trends is always enabled automatically.

# --- App Settings ---
# How often to fetch trends (in minutes)
FETCH_INTERVAL_MINUTES=60
